<Window x:Class="memoriajatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:memoriajatek"
        mc:Ignorable="d"
        Title="Simple Memory" Height="700" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="250"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid x:Name="GridGame" Grid.Column="0" Background="Azure"></Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <ListBox x:Name="LBoxSize" FontSize="30" Margin="10"></ListBox>
                <ListBox x:Name="LBoxType" FontSize="30" Margin="10"></ListBox>
                <Label x:Name="LblScore" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            </StackPanel>
            <Button Grid.Row="1" FontSize="40" Click="Btn_Start_Click">Start</Button>
        </Grid>
    </Grid>
</Window>
