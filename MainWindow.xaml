<Window x:Class="memoriajatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:memoriajatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="Grid_Main">
        <ListBox x:Name="LBox_size" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="30"></ListBox>
        <ListBox x:Name="LBox_type" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="30"></ListBox>  
        <Button x:Name="Btn_Start" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="50" Click="Btn_Start_Click">Start</Button>
    </Grid>
</Window>
