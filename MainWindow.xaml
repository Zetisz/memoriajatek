<Window x:Class="memoriajatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:memoriajatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="250"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Grid_Game" Grid.Column="0" Background="Azure"></Grid>
        <Grid x:Name="Grid_Controls" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <ListBox x:Name="LBox_size" FontSize="30"></ListBox>
                <ListBox x:Name="LBox_type" FontSize="30"></ListBox>
                <Label x:Name="Lbl_score" FontSize="30" FontWeight="Bold"></Label>
            </StackPanel>
            <Button x:Name="Btn_Start" Grid.Row="1" FontSize="40" Click="Btn_Start_Click">Start</Button>
        </Grid>
    </Grid>
</Window>
